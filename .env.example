# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real secrets.

# --- Database ---
# Local dev default (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
# Production (swap provider in prisma/schema.prisma to "postgresql" first):
# DATABASE_URL="postgresql://user:password@host:5432/dbname"

# --- NextAuth.js core ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# --- KMUTT SSO (Microsoft Entra ID / Azure AD) ---
# Register an app in the KMUTT Azure AD tenant to get these three values.
# Redirect URI to register: {NEXTAUTH_URL}/api/auth/callback/azure-ad
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""

# --- Local dev login fallback ---
# When set to "true", a password-less "sign in as any email" form is shown
# on /login IN ADDITION to the Azure AD button, so the app is testable before
# real SSO credentials are wired up. Must be unset/"false" in production.
ENABLE_DEV_LOGIN="true"
